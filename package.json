{
  "name": "archivo-familiar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "start:api": "tsx apps/api/src/server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/source-sans-3": "^5.2.0",
    "@xyflow/react": "^12.8.0",
    "csv-parse": "^7.0.3",
    "elkjs": "^0.10.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
